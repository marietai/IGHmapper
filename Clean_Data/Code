
# Check Missingness
plink2 --bfile /raw/data/here\
       --missing \
       --out /missingness of both individuals and SNPs\

# Remove Individuals with High Missingness (>2%)

plink2 --bfile /raw/data/here\
       --mind 0.02 \
       --make-bed \
       --out /a flie with removed individuals exceeding a certain missing genotype call rate


# Remove SNPs with missingness >2%:
plink2 --bfile /a flie with removed individuals exceeding a certain missing genotype call rate\
       --geno 0.02 \
       --make-bed \
       --out /a flie with removed SNPs exceeding a certain missing genotype call rate

# Perform LD pruning
plink2 --bfile /previous data path\
       --indep-pairwise 50 5 0.2 \
       --out /SNPs that passed LD pruning.

plink2 --bfile /previous data path\
       --extract /SNPs that passed LD pruning\
       --make-bed \
       --out /LDpruned_data

#het Check
